# healthcheck.nyan — probe every endpoint listed in a file and report.
#
#   meow run examples/healthcheck.nyan
#   meow run examples/healthcheck.nyan path/to/targets.txt
#
# Reads a file of URLs, one per line, defaulting to examples/targets.txt. Ends
# with a status of 1 if any endpoint is down, so cron or a CI step can act on
# the answer without reading the report.
nab "http"
nab "file"
nab "clock"
nab "env"

# http.chase reports a non-2xx status in its map rather than as a Furball, which
# is what a health check wants: 503 is an answer, an unreachable host is not.
# A Furball here means the request could not be made at all, so it is worth one
# retry before calling the endpoint down.
meow probe(url string) litter {
  nyan r = http.chase("GET", url)
  sniff (is_furball(r)) {
    clock.nap(200)
    bring http.chase("GET", url)
  }
  bring r
}

meow line(url string) string {
  nyan r = probe(url)
  sniff (is_furball(r)) {
    bring pad("DOWN", 6) + url
  }
  bring pad(to_string(r["status"]), 6) + url
}

meow down_count(lines litter) int {
  # Bindings are immutable, so a running total is a fold rather than a counter
  # that the loop body assigns to.
  bring curl(lines, 0, paw(acc, l) {
    # Every line starts with either a status or DOWN, so anything that does not
    # start with a 2 is an endpoint that did not answer well. Counting only the
    # DOWN lines would have a 503 reported and then called healthy.
    sniff (nibble(l, 0, 1) == "2") { bring acc }
    bring acc + 1
  })
}

# The file to read comes from the command line when one was given, so the same
# check can be pointed at staging or production without editing it.
meow target_file(given litter) string {
  sniff (len(given) > 0) {
    bring head(given)
  }
  bring "examples/targets.txt"
}

nyan targets = file.stalk(target_file(env.haul()))
nyan lines = lick(targets, paw(u) { line(u) })

purr l (sort(lines)) { nya(l) }
nya("---")

nyan down = down_count(lines)
nya(to_string(len(targets)) + " checked, " + to_string(down) + " down")

# A status rather than a hiss: nothing went wrong with the check itself, and
# the caller wants the answer, not an error message about it.
sniff (down > 0) {
  scram(1)
}
