# A list-form purr inside a fully-typed function. The body must be generated by
# the typed statement generator: the untyped one ends statements with the
# Furball short-circuit `return __f`, which a function returning a native Go
# type cannot compile.

meow each(n int) int {
  purr item (["a", "b"]) {
    nya(item)
  }
  bring n
}
nya(each(0))

# The element is a meow.Value even where the checker knows its element type,
# so it must be unboxed to be used as a native, and not boxed a second time.
meow suffix(sep string) string {
  purr word (["a", "b"]) {
    nya(word + sep)
  }
  bring sep
}
nya(suffix("-"))

# Index form
meow indexed(n int) int {
  purr i, word (["x", "y"]) {
    nya(i)
    nya(word)
  }
  bring n
}
nya(indexed(7))

# Element handed to a builtin that takes a meow.Value
meow lengths(n int) int {
  purr w (["aa", "bbb"]) {
    nya(len(w))
  }
  bring n
}
nya(lengths(1))

# Element compared against a typed parameter
meow findit(target string) string {
  purr w (["cat", "dog"]) {
    sniff (w == target) { nya("found:" + w) }
  }
  bring target
}
nya(findit("dog"))

# List form nested inside the numeric form
meow grid(n int) int {
  purr i (n) {
    purr w (["p", "q"]) {
      nya(w)
    }
  }
  bring n
}
nya(grid(2))

# The untyped path is unchanged
meow plain(xs litter) {
  purr w (xs) { nya(w) }
}
plain(["u", "v"])
