# A call written as a statement inside a fully typed function.
#
# Its value is discarded, so a Furball it answered with used to vanish: the
# function carried on and reported success, while the same program in the
# playground failed. A typed function returns a native Go type and cannot pass a
# Furball on, so the failure is raised instead and `gag` or `~>` catches it at
# the boundary.

# Answers with a Furball, though it is declared to return a litter.
meow reversed(s string) litter {
  bring reverse(s)
}

meow keeps_going(n int) int {
  reversed("not a litter")
  nya("this line must not be reached")
  bring n
}
nya(to_string(keeps_going(5)) ~> "the failure was noticed")

# The same with a native return type, where the unboxing raises it.
meow doubled(xs litter) string {
  bring xs[0] + 1
}

meow also_keeps_going(n int) int {
  doubled(["oops"])
  nya("this line must not be reached either")
  bring n
}
nya(to_string(also_keeps_going(5)) ~> "this failure too")

# A call that succeeds is still just a statement: nothing is raised, and what it
# printed on the way stays printed.
meow announce(what string) string {
  nya("announcing " + what)
  bring what
}

meow uses_it(n int) int {
  announce("a number")
  bring n
}
nya(to_string(uses_it(7)))

# A statement that is not a call discards its value just the same. A pipe, an
# index and a piece of arithmetic each answer with a Furball here, and each one
# used to be dropped while the playground raised it.
meow piped(n int) int {
  ["not a number"] |=| head |=| to_int
  nya("this line must not be reached")
  bring n
}
nya(to_string(piped(5)) ~> "the pipe was noticed")

meow indexed(n int) int {
  [1, 2][9]
  nya("this line must not be reached")
  bring n
}
nya(to_string(indexed(5)) ~> "the index was noticed")

meow divided(n int) int {
  n / 0
  nya("this line must not be reached")
  bring n
}
nya(to_string(divided(5)) ~> "the division was noticed")

# A statement inside a loop is a statement like any other, so the check goes
# where the statement is rather than only at the top of the body.
meow in_a_loop(n int) int {
  purr i (0..2) {
    doubled(["oops"])
    nya("this line must not be reached")
  }
  bring n
}
nya(to_string(in_a_loop(5)) ~> "the loop was stopped")

# A failure already caught is not raised again: gag hands back a Furball marked
# as handled, and a statement holding one carries on.
meow already_caught(n int) int {
  nyan caught = gag(paw() { bring doubled(["oops"]) })
  caught
  nya("this line is reached")
  bring n
}
nya(to_string(already_caught(9)))
