# sniff/scratch inside a lambda
nyan classify = paw(n) { sniff (n > 10) { bring "big" } scratch { bring "small" } }
nya(classify(5))
nya(classify(50))

# single-expression form still works
nyan double = paw(x int) { x * 2 }
nya(double(21))

# multi-statement body, trailing expression is the result
nyan area = paw(w, h) {
  nyan a = w * h
  a + 1
}
nya(area(3, 4))

# block body used with a higher-order builtin
nyan xs = [1, 2, 3, 4]
nya(xs |=| picky(paw(x) { sniff (x > 2) { bring yarn } scratch { bring hairball } }))
